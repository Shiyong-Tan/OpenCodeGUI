.opencode/**

.sisyphus/**

.tmp-librarian/**

hello_world

.vscode/**

# source files (not needed in extension package)
src/**
scripts/**
webview-src/**
tsconfig.json
tsconfig.webview.json

# development configs
.vscode/**
.git/**
.gitignore
.npmignore

# logs
*.log
OpenCode*.log
stderr.txt

# temporary / debug files
_tmp_*
debug-webview.html
hello_world.py

# documentation not needed at runtime
IssueNotSolved.md
RESYNC_RESCUE_DESIGN.md
UNDO_RESTORE_DESIGN.md
grouped-resync-activity.md
sse_resync.md

# local config
config.json

# tests
test/**
tests/**
image/**

# node modules - exclude devDependencies, keep only runtime deps
node_modules/.bin/**
node_modules/@types/**
node_modules/typescript/**
node_modules/.package-lock.json

# build artifacts not needed
*.map
*.vsix

# OS junk
.DS_Store
Thumbs.db

nul
opencode-gui@*

# extension package should be clean, exclude unwanted files from it
extension/*.exe
extension/*.log
extension/%TEMP%*
extension/rustup-init.exe

# root level temp files and executables (should never be packaged)
*.exe
%TEMP%*
rustup-init*

# docs not needed at runtime (keep essential ones)
extension/TEST_VERIFICATION.md
extension/release-notes.md
extension/help.txt

# assets that may be build artifacts
extension/assets/*.exe
